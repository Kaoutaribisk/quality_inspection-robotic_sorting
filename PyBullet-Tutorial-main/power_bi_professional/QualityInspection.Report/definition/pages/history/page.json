{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/page/1.0.0/schema.json",
  "name": "history",
  "displayName": "Inspection history",
  "displayOption": "FitToPage",
  "width": 1280,
  "height": 720,
  "objects": {
    "background": [
      {
        "properties": {
          "color": {
            "solid": {
              "color": {
                "expr": {
                  "Literal": {
                    "Value": "'#F3F6FA'"
                  }
                }
              }
            }
          },
          "transparency": {
            "expr": {
              "Literal": {
                "Value": "0D"
              }
            }
          }
        }
      }
    ]
  },
  "visualInteractions": [
    {
      "source": "records",
      "target": "evidence",
      "type": "DataFilter"
    },
    {
      "source": "evidence",
      "target": "records",
      "type": "NoFilter"
    }
  ]
}
