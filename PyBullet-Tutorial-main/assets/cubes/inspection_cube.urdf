<?xml version="1.0"?>
<robot name="inspection_product">
  <link name="product">
    <contact><lateral_friction value="1"/></contact>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="1e-4" iyy="1e-4" izz="1e-4" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <geometry><mesh filename="inspection_cube.obj" scale="0.05 0.05 0.05"/></geometry>
      <material name="steel"><color rgba="1 1 1 1"/></material>
    </visual>
    <collision><geometry><box size="0.05 0.05 0.05"/></geometry></collision>
  </link>
</robot>
